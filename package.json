{
  "$schema": "./schemas/meta/package.json",
  "name": "xikii-discord-case",
  "productName": "XIKII Discord Case",
  "desktopName": "xikii-discord-case",
  "version": "0.1.5",
  "description": "Discord client with Qwen translation, based on WebCord.",
  "main": "app/code/common/main.js",
  "scripts": {
    "test": "tsc && node --test tests/*.test.cjs && oxlint",
    "lint": "oxlint",
    "build": "tsc",
    "compile": "tsc",
    "tsc": "tsc",
    "watch": "tsc --watch",
    "start": "tsc && electron .",
    "package": "tsc && electron-forge package",
    "make": "tsc && electron-forge make",
    "publish": "tsc && electron-forge publish",
    "prepack": "tsc && electron-forge package && echo 'This script will now fail to cancel creating a Node package...' && exit 1",
    "test:translation": "tsc && node --test tests/*.test.cjs",
    "test:electron": "tsc && electron tests/electron-smoke.cjs",
    "test:slate": "tsc && electron tests/electron-slate.cjs",
    "test:session": "tsc && electron tests/electron-session.cjs write && electron tests/electron-session.cjs read",
    "test:cache": "tsc && electron tests/electron-translation-cache.cjs"
  },
  "author": {
    "name": "SpacingBat3",
    "email": "git@spacingbat3.anonaddy.com",
    "url": "https://github.com/SpacingBat3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XikiiMaker/XIKII-Discord-Case"
  },
  "bugs": {
    "url": "https://github.com/XikiiMaker/XIKII-Discord-Case/issues"
  },
  "homepage": "https://github.com/XikiiMaker/XIKII-Discord-Case#readme",
  "devDependencies": {
    "@electron-forge/cli": "^7.1.0",
    "@electron-forge/maker-deb": "^7.1.0",
    "@electron-forge/maker-dmg": "^7.1.0",
    "@electron-forge/maker-flatpak": "^7.1.0",
    "@electron-forge/maker-rpm": "^7.1.0",
    "@electron-forge/maker-snap": "^7.1.0",
    "@electron-forge/maker-squirrel": "^7.1.0",
    "@electron-forge/maker-wix": "^7.1.0",
    "@electron-forge/maker-zip": "^7.1.0",
    "@electron-forge/plugin-fuses": "^7.1.0",
    "@electron-forge/publisher-github": "^7.1.0",
    "@electron/fuses": "^1.5.0",
    "@electron/windows-sign": "^1.2.2",
    "@reforged/maker-appimage": "^5.0.0",
    "@tsconfig/strictest": "^2.0.0",
    "@types/node": "^20.16.1",
    "@types/semver": "^7.3.9",
    "@types/source-map-support": "^0.5.4",
    "@types/ws": "^8.5.1",
    "electron": ">=43.1.0 < 43.3.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.0.1",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "slate": "0.126.2",
    "slate-dom": "0.126.0",
    "slate-react": "0.126.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@spacingbat3/disconnection": "^1.0.3",
    "@spacingbat3/kolor": "^4.0.0",
    "deepmerge-ts": "^7.0.3",
    "dompurify": "^3.0.1",
    "marked": "^18.0.2",
    "marked-alert": "^2.1.2",
    "marked-gfm-heading-id": "^4.0.0",
    "semver": "^7.3.5",
    "source-map-support": "^0.5.21",
    "tslib": "^2.3.1",
    "twemoji-colr-font": "^15.0.3"
  },
  "config": {
    "forge": "./app/code/build/forge.mjs"
  },
  "engines": {
    "node": "^16.10.0 || ^18.10.0 || >=19.0.0",
    "npm": ">=8.0.0"
  },
  "private": true,
  "allowScripts": {
    "@bitdisaster/exe-icon-extractor@1.0.10": true,
    "electron-winstaller@5.4.4": true
  },
  "overrides": {
    "extract-zip": "npm:@electron-internal/extract-zip@latest",
    "@electron/rebuild": "^4.2.0"
  }
}
